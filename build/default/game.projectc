[android]
debuggable = 0
display_cutout = 1
extract_native_libs = 0
iap_provider = GooglePlay
immersive_mode = 0
input_method = HiddenInputField
manifest = /builtins/manifests/android/AndroidManifest.xml
minimum_sdk_version = 21
package = com.example.todo
target_sdk_version = 36
version_code = 1
vkquality_database = /builtins/manifests/android/vkqualitydata.vkq

[bootstrap]
main_collection = /main/main.collectionc
render = /scene3d/render/render3d.renderc

[box2d]
position_iterations = 10
sub_step_count = 4
velocity_iterations = 10

[collection]
max_input_stack_entries = 16
max_instances = 2048

[collection_proxy]
max_count = 10

[collectionfactory]
max_count = 512

[display]
display_device_info = 0
display_profiles = /scene3d/helpers/gui.display_profilesc
dynamic_orientation = 0
fullscreen = 0
height = 1080
high_dpi = 1
samples = 0
swap_interval = 1
update_frequency = 120
variable_dt = 0
vsync = 1
width = 1920

[druid]
no_auto_input = 1

[engine]
fixed_update_frequency = 60
max_time_step = 0.033333
run_while_iconified = 0

[factory]
max_count = 128

[font]
runtime_generation = 0

[graphics]
default_texture_mag_filter = linear
default_texture_min_filter = linear
max_characters = 8192
max_debug_vertices = 100000
max_draw_calls = 10000
max_font_batches = 128
memory_size = 512
opengl_core_profile_hint = 1
opengl_version_hint = 33
texture_profiles = /main/compressed.texture_profilesc
verify_graphics_calls = 1
vulkan_version_major = 1
vulkan_version_minor = 0
webgl_version_hint = 2

[gui]
max_animation_count = 1024
max_count = 64
max_particle_count = 1024
max_particlefx_count = 64
safe_area_mode = none

[html5]
archive_location_prefix = archive
cssfile = /builtins/manifests/web/dark_theme.css
custom_heap_size = 0
engine_arguments = --verify-graphics-calls=false
heap_size = 64
htmlfile = /builtins/manifests/web/engine_template.html
retry_count = 10
retry_time = 1.0
scale_mode = fit
set_custom_heap_size = 0
show_console_banner = 1
show_fullscreen_button = 1
show_made_with_defold = 1
splash_image = /cover_web.png
transparent_graphics_context = 0
verify_downloaded_file_size = 1
wasm_streaming = 0

[input]
game_binding = /builtins/input/all.input_bindingc
gamepad_deadzone = 0.2
gamepads = /builtins/input/default.gamepadsc
repeat_delay = 0.5
repeat_interval = 0.2
use_accelerometer = 0

[ios]
bundle_identifier = example.unnamed
default_language = en
infoplist = /builtins/manifests/ios/Info.plist
launch_screen = /builtins/manifests/ios/LaunchScreen.storyboardc
localizations = en
pre_renderered_icons = 0
privacymanifest = /builtins/manifests/ios/PrivacyInfo.xcprivacy

[label]
max_count = 64
subpixels = 1

[library]
include_dirs = scene3d

[light]
max_count = 64

[liveupdate]
enabled = 1
settings = /liveupdate.settings

[mesh]
max_count = 10000

[model]
max_bone_matrix_texture_height = 1024
max_bone_matrix_texture_width = 1024
max_count = 10000
max_morph_target_texture_height = 1024
max_morph_target_texture_width = 1024
split_meshes = 0

[network]
http_cache_enabled = 1
http_thread_count = 4
http_timeout = 0.0

[osx]
bundle_identifier = example.unnamed
bundle_version = 1
default_language = en
infoplist = /builtins/manifests/osx/Info.plist
localizations = en
privacymanifest = /builtins/manifests/osx/PrivacyInfo.xcprivacy

[particle_fx]
max_count = 64
max_emitter_count = 64
max_particle_buffer_count = 1024
max_particle_count = 1024

[physics]
allow_dynamic_transforms = 1
contact_impulse_limit = 0.0
debug = 0
debug_alpha = 0.9
debug_scale = 30.0
gravity_x = 0.0
gravity_y = -9.8
gravity_z = 0.0
max_collision_object_count = 2000
max_collisions = 10000
max_contacts = 10000
max_fixed_timesteps = 1
ray_cast_limit_2d = 64
ray_cast_limit_3d = 1000
scale = 1.0
trigger_overlap_capacity = 1000
type = 3D
use_fixed_timestep = 1
velocity_threshold = 1.0
world_count = 5

[profiler]
enabled = 1
max_sample_count = 4096
performance_timeline_enabled = 0
sleep_between_server_updates = 0
track_cpu = 0
track_detailed_memory = 0

[project]
compress_archive = 1
dependencies_metadata = 0
minimum_log_level = 1
title = GalacticGarbage
version = 1.0
write_log = 0
write_log_file = 0

[render]
clear_color_alpha = 1.0
clear_color_blue = 0.25
clear_color_green = 0.25
clear_color_red = 0.25

[resource]
http_cache = 0
max_resources = 10000

[script]
shared_state = 1

[shader]
exclude_gles_sm100 = 0
glsl_es_default_precision_float = mediump
glsl_es_default_precision_int = highp
output_spirv = 1

[sound]
gain = 1.0
max_component_count = 100
max_sound_buffers = 100
max_sound_data = 128
max_sound_instances = 256
max_sound_sources = 16
sample_frame_count = 0
stream_cache_size = 2097152
stream_chunk_size = 16384
stream_enabled = 0
stream_preload_size = 16384
use_linear_gain = 1
use_thread = 1

[sprite]
max_count = 10000
subpixels = 1

[tilemap]
max_count = 16
max_tile_count = 2048

